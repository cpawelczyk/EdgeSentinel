        "spec": {
          "id": 6,
          "title": "SITE HEALTH",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-azure-monitor-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efw3b1m4obzeoa"
                      },
                      "spec": {
                        "azureLogAnalytics": {
                          "dashboardTime": true,
                          "mode": "raw",
                          "query": "EdgeSentinel_CL\n| summarize arg_max(TimeGenerated, *) by deviceId\n| extend EffectiveStatus = iff(TimeGenerated < ago(3m), \"unknown\", status)\n| where siteId != \"shared\"\n| summarize Devices=count(), Available=countif(EffectiveStatus in (\"online\",\"degraded\")) by siteId\n| extend Availability = round(100.0 * Available / Devices, 1)\n| extend Site = case(\n    siteId==\"detroit\",\"DTW\",\n    siteId==\"atlanta\",\"ATL\",\n    siteId==\"phoenix\",\"PHX\",\n    toupper(siteId)\n)\n| project Site, Availability\n| order by Availability asc",
                          "resources": [
