                      "id": "byName",
                      "scope": "series",
                      "options": "Status"
                    },
                    "properties": [
                      {
                        "id": "custom.cellOptions",
                        "value": {
                          "type": "color-text"
                        }
                      },
                      {
                        "id": "mappings",
                        "value": [
                          {
                            "type": "value",
                            "options": {
                              "healthy": {
                                "text": "HEALTHY",
                                "color": "green",
                                "index": 0
                              },
                              "degraded": {
                                "text": "DEGRADED",
                                "color": "yellow",
                                "index": 1
                              },
                              "offline": {
                                "text": "OFFLINE",
                                "color": "red",
                                "index": 2
                              },
                              "unknown": {
                                "text": "UNKNOWN / STALE",
                                "color": "orange",
                                "index": 3
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "transparent": true
