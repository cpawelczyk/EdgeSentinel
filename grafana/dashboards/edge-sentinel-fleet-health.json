      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "ACTIVE INCIDENTS",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-azure-monitor-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efw3b1m4obzeoa"
                      },
                      "spec": {
                        "azureLogAnalytics": {
                          "dashboardTime": true,
                          "mode": "raw",
                          "query": "let Latest =\n    EdgeSentinel_CL\n    | summarize arg_max(TimeGenerated, *) by deviceId\n    | extend IsStale = TimeGenerated < ago(3m)\n    | extend EffectiveStatus = iff(IsStale, \"unknown\", status);\nlet Issues =\n    Latest\n    | where EffectiveStatus != \"online\"\n    | extend Reason = iff(IsStale, \"heartbeat stale\", failureReason)\n    | extend Site = case(siteId==\"detroit\",\"DTW\", siteId==\"atlanta\",\"ATL\", siteId==\"phoenix\",\"PHX\", toupper(siteId))\n    | project Site, Device=deviceId, Status=EffectiveStatus, Reason, LastSeen=TimeGenerated;\nlet Healthy =\n    Latest\n    | summarize IssueCount=countif(EffectiveStatus != \"online\"), LastSeen=max(TimeGenerated)\n    | where IssueCount == 0\n    | project Site=\"FLEET\", Device=\"—\", Status=\"healthy\", Reason=\"No active incidents\", LastSeen;\nunion Issues, Healthy\n| order by Status asc, Site asc",
                          "resources": [
                            "/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.OperationalInsights/workspaces/<workspace-name>"
                          ],
                          "resultFormat": "logs",
                          "timeColumn": "TimeGenerated"
                        },
                        "azureMonitor": {
                          "allowedTimeGrainsMs": [],
                          "dimensionFilters": [],
                          "metricNamespace": "microsoft.operationalinsights/workspaces",
                          "region": "eastus",
                          "resources": [
                            {
                              "metricNamespace": "Microsoft.OperationalInsights/workspaces",
                              "region": "eastus",
                              "resourceGroup": "<resource-group-name>",
                              "resourceName": "<workspace-name>",
                              "subscription": "<subscription-id>"
                            }
                          ],
                          "timeGrain": "auto"
                        },
                        "queryType": "Azure Log Analytics",
                        "subscription": "<subscription-id>"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.0",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
