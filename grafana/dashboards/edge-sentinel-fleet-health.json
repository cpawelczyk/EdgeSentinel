                          "query": "EdgeSentinel_CL\n| summarize arg_max(TimeGenerated, *) by deviceId\n| extend EffectiveStatus=iff(TimeGenerated < ago(3m),\"unknown\",status)\n| where siteId != \"shared\"\n| summarize Devices=count(),\n            Online=countif(EffectiveStatus==\"online\"),\n            Degraded=countif(EffectiveStatus==\"degraded\"),\n            Offline=countif(EffectiveStatus==\"offline\"),\n            Unknown=countif(EffectiveStatus==\"unknown\") by siteId\n| extend Availability=round(100.0*(Online+Degraded)/Devices,1)\n| extend Site=toupper(siteId)\n| extend Latitude=case(siteId==\"detroit\",42.3314,siteId==\"phoenix\",33.4484,siteId==\"atlanta\",33.7490,real(null)),\n         Longitude=case(siteId==\"detroit\",-83.0458,siteId==\"phoenix\",-112.0740,siteId==\"atlanta\",-84.3880,real(null))\n| where isnotnull(Latitude)\n| project Site, Latitude, Longitude, Availability, Devices, Online, Degraded, Offline, Unknown",
                          "resources": [
