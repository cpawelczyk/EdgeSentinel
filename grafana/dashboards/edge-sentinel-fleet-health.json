      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "DATA AGE",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-azure-monitor-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "efw3b1m4obzeoa"
                      },
                      "spec": {
                        "azureLogAnalytics": {
                          "dashboardTime": true,
                          "mode": "raw",
                          "query": "EdgeSentinel_CL\n| summarize Latest=max(TimeGenerated)\n| extend TelemetryAgeSec = max_of(0, toint(datetime_diff(\"second\", now(), Latest)))\n| project TelemetryAgeSec",
                          "resources": [
                            "/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.OperationalInsights/workspaces/<workspace-name>"
                          ],
                          "resultFormat": "logs",
                          "timeColumn": "TimeGenerated"
                        },
                        "azureMonitor": {
                          "allowedTimeGrainsMs": [],
                          "dimensionFilters": [],
                          "metricNamespace": "microsoft.operationalinsights/workspaces",
                          "region": "eastus",
                          "resources": [
                            {
                              "metricNamespace": "Microsoft.OperationalInsights/workspaces",
                              "region": "eastus",
                              "resourceGroup": "<resource-group-name>",
                              "resourceName": "<workspace-name>",
