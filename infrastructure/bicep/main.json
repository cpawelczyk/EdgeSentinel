      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2024-03-11').endpoints.logsIngestion]"
    },
    "streamName": {
      "type": "string",
      "value": "[variables('streamName')]"
    }
  }
