      "metadata": {
        "description": "Azure region for Edge Sentinel observability resources."
      }
    },
    "workspaceName": {
      "type": "string",
      "defaultValue": "law-edgesentinel-dev",
      "metadata": {
        "description": "Log Analytics workspace name."
      }
    },
    "dcrName": {
      "type": "string",
      "defaultValue": "dcr-edgesentinel-dev",
      "metadata": {
        "description": "Data Collection Rule name."
      }
    },
    "tableName": {
      "type": "string",
      "defaultValue": "EdgeSentinel_CL",
      "metadata": {
        "description": "Custom Log Analytics table name."
      }
    },
    "retentionInDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Retention period for the Log Analytics workspace and custom table."
      }
    }
  },
  "variables": {
    "streamName": "Custom-EdgeSentinel",
    "destinationName": "EdgeSentinelWorkspace"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('workspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
