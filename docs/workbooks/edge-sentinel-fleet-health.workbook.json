{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "<div style=\"text-align:center;\"><h1>Edge Sentinel — Fleet Health</h1><p>Real-time operational health and availability of the simulated edge infrastructure fleet.</p></div>"
      },
      "customWidth": "100",
      "name": "text-workbook-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "EdgeSentinel_CL\r\n| summarize arg_max(TimeGenerated, *) by deviceId\r\n| summarize\r\n    TotalDevices = count(),\r\n    Online = countif(status == \"online\"),\r\n    Degraded = countif(status == \"degraded\"),\r\n    Offline = countif(status == \"offline\"),\r\n    Unknown = countif(status == \"unknown\")\r\n| extend AvailabilityPct = round(100.0 * Online / TotalDevices, 1)",
        "size": 0,
        "timeContext": {
          "durationMs": 86400000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "stat",
        "tileSettings": {
          "showBorder": false
        },
        "statSettings": {
          "valueField": "TotalDevices",
          "valueAggregation": "None",
          "colorSettings": {
            "type": "static",
            "mode": "background",
            "heatmapPalette": "greenRed",
            "thresholdsGrid": []
          },
          "iconSettings": {
            "thresholdsGrid": []
          },
          "tagText": "TOTAL DEVICES",
          "valueFontStyle": "auto"
        }
      },
      "customWidth": "16",
      "name": "kpi-total-devices"
    },
