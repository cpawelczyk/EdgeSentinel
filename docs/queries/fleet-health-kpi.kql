EdgeSentinel_CL
| summarize arg_max(TimeGenerated, *) by deviceId
| summarize
    TotalDevices = count(),
    Online = countif(status == "online"),
    Degraded = countif(status == "degraded"),
    Offline = countif(status == "offline"),
    Unknown = countif(status == "unknown")
| extend Available = Online + Degraded
| extend AvailabilityPct = round(100.0 * Available / TotalDevices, 1)